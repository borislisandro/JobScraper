{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobScraper", "version": "1.0.0", "identifier": "com.jobscraper.local",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "JobScraper", "width": 1240, "height": 840, "minWidth": 900, "minHeight": 650 }], "security": { "csp": "default-src 'self'; connect-src 'self' http://tauri.localhost https://tauri.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "windows": { "nsis": { "installMode": "currentUser" } }, "resources": { "../sidecar/*": "sidecar", "resources/models/*": "models" } }
}
