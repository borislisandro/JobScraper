{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobScraper", "version": "1.0.0", "identifier": "com.jobscraper.local",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "beforeBundleCommand": { "script": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\prepare-release.ps1 -PreflightOnly", "cwd": ".." }, "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "JobScraper", "width": 1240, "height": 840, "minWidth": 900, "minHeight": 650, "visible": false, "decorations": false }], "security": { "csp": "default-src 'self'; connect-src 'self' http://tauri.localhost https://tauri.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"], "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser", "installerHooks": "windows/installer-hooks.nsh" } }, "resources": { "sidecar": "sidecar", "../scripts/repair-startup.ps1": "repair-startup.ps1" } }
}
